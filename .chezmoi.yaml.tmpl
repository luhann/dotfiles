sourceDir: "{{ .chezmoi.homeDir }}/dotfiles"
pager: delta

{{- /* Detect whether we're running in Codespaces. */ -}}
{{- $codespaces:= env "CODESPACES" | not | not -}}

{{- /* Per-host record lives in .chezmoitemplates/hosts/<hostname>.yaml.tmpl,
       which owns chassis, nvidia, hwmon resolution, and the monitor profile.
       Unregistered machines fall back to hosts/_default.yaml. */ -}}
{{- $host := includeTemplate "hosts/_default.yaml.tmpl" . | fromYaml }}
{{- if stat (joinPath .chezmoi.sourceDir ".chezmoitemplates" "hosts" (printf "%s.yaml.tmpl" .chezmoi.hostname)) }}
{{-   $host = merge (includeTemplate (printf "hosts/%s.yaml.tmpl" .chezmoi.hostname) . | fromYaml) $host }}
{{- end }}

{{- /* Prompt once for theme selection and load that palette. */ -}}
{{- $color_scheme := promptStringOnce . "color_scheme" "What color scheme to use" "patroclus" -}}
{{- $color_palette := (includeTemplate (print $color_scheme ".yaml") | fromYaml).colors }}

data:
  browser: {{ $host.browser | quote }}
  chassis_type: {{ $host.chassis_type | quote }}
  codespaces: {{ $codespaces }}
  color_scheme: {{ $color_scheme | quote }}
  has_nvidia: {{ $host.has_nvidia }}
  hwmon_path: {{ $host.hwmon_path | quote }}

  colors:
    # Defaults not provided by the selected color palette.
    white: "#ffffff"
    black: "#000000"
{{- range $key, $val := $color_palette }}
    {{ $key }}: {{ $val | quote }}
{{- end }}

  # Monitor layout is named by the host file; see .chezmoitemplates/monitors/.
  monitor_profile: {{ $host.monitor_profile | quote }}
  monitors:
{{ includeTemplate (printf "monitors/%s.yaml" $host.monitor_profile) . | trim | indent 4 }}
