{{- /* Gentoo is the only OS in the fleet; osRelease only exists on Linux, and
       chezmoi only strips double quotes from os-release values (Gentoo uses ID='gentoo'). */ -}}
{{- $osRelease := default (dict) (get .chezmoi "osRelease") -}}
{{- $osId := trimAll `"` (trimAll "'" (default "" (get $osRelease "id"))) -}}
{{- $isGentoo := or (eq $osId "gentoo") (contains "gentoo" (default "" (get $osRelease "idLike"))) -}}
# fish_add_path is idempotent; one call instead of one per directory saves ~8ms
fish_add_path --global \
    ~/bin \
    ~/.cargo/bin \
    ~/.local/bin \
    ~/.cabal/bin \
    ~/.ghcup/bin \
    ~/applications/texlive/2026/bin/x86_64-linux \
    ~/applications/cmdstan/bin \
    ~/applications/xbps/usr/bin \
    ~/.opencode/bin

# Environment variables
set -gx EDITOR nvim
set -gx VISUAL nvim
set -gx BROWSER {{ .browser }}
set -gx FZF_DEFAULT_COMMAND "fd --type file --color=always"

# gpg-agent is the ssh agent (YubiKey [A] subkey). Outside the interactive
# guard so scripts inherit it; the fixed path is resolved at apply time.
{{- if lookPath "gpgconf" }}
set -gx SSH_AUTH_SOCK {{ output "gpgconf" "--list-dirs" "agent-ssh-socket" | trim }}
{{- end }}

{{- if $isGentoo }}
# Clang/LLVM toolchain
set -gx CC clang
set -gx CXX clang++
set -gx CPP clang-cpp
set -gx FC flang
set -gx LD ld.lld
set -gx AR llvm-ar
set -gx NM llvm-nm
set -gx RANLIB llvm-ranlib
set -gx OBJCOPY llvm-objcopy
set -gx STRIP llvm-strip
set -gx OBJDUMP llvm-objdump
set -gx READELF llvm-readelf

set -gx CFLAGS "-march=native -O2 -flto=thin"
set -gx CXXFLAGS "-march=native -O2 -flto=thin"
set -gx LDFLAGS "-fuse-ld=lld -Wl,-O1 -Wl,--as-needed"
set -gx RUSTFLAGS "-C target-cpu=native -C opt-level=3"
set -gx MAKEFLAGS -j{{ output "nproc" | trim }}
{{- end}}

if status --is-interactive
    # only interactive shells have a tty for gpg to prompt on
    set -gx GPG_TTY (tty)

    # Interactive only, so scripts get the real commands. Functions, not
    # `alias`, which costs ~9ms at startup.
    function sudo --wraps=run0; run0 $argv; end
    # Modern command replacements
    function cat --wraps=bat; bat --paging=never $argv; end
    function ls --wraps=eza; eza --long --header --git --color=auto --group-directories-first $argv; end
    function find --wraps=fd; fd $argv; end
    function top --wraps=btop; btop $argv; end
    function grep --wraps=rg; rg $argv; end
    function vim --wraps=nvim; nvim $argv; end

    # System management
    function off; sudo poweroff; end
    function cp --wraps=cp; command cp -v --reflink=auto $argv; end
    function mv --wraps=mv; command mv -v $argv; end
    function xo --wraps=xdg-open; xdg-open $argv; end

    # Process management
    function psa; ps aux $argv; end
    function psg; ps aux | rg -i $argv; end

    # Helper utilities
    function preview --wraps=fzf; fzf --preview 'bat --color=always {}' $argv; end
    function weather; curl -4 wttr.in/Cape+Town; end

    abbr --add scu "systemctl --user"
    abbr --add scus "systemctl --user status"
    abbr --add scs "systemctl status"

    # OS-specific package management
{{- if $isGentoo }}
    abbr --add einstall "sudo emerge --ask --verbose"
    abbr --add eremove "sudo emerge --ask --depclean"
    abbr --add eupdate "sudo emerge --ask --verbose --quiet --newuse --update --deep @world"
    abbr --add edepclean "sudo emerge --ask --depclean"
    abbr --add esync "sudo eix-sync"
    abbr --add esearch "eix"
{{- end}}

    # Useful abbreviations
    # Git
    abbr --add g "git"
    abbr --add gst "git status"
    abbr --add gc "git commit"
    abbr --add gco "git checkout"
    abbr --add ga "git add"
    abbr --add gaa "git add --all"
    abbr --add gb "git branch"
    abbr --add gd "git diff"
    abbr --add gl "git log"
    abbr --add gp "git push"
    abbr --add gpf "git push --force-with-lease"
    abbr --add gpl "git pull"

    # Jujutsu
    abbr --add j "jj"
    abbr --add js "jj st"
    abbr --add jd "jj diff"
    abbr --add jl "jj log"
    abbr --add jn "jj new"
    abbr --add jds "jj describe"
    abbr --add jsq "jj squash"
    abbr --add jt "jj tug"
    abbr --add jgp "jj git push"
    abbr --add jgf "jj git fetch"

    # Chezmoi
    abbr --add cz "chezmoi"
    abbr --add cza "chezmoi apply"
    abbr --add czd "chezmoi diff"
    abbr --add cze "chezmoi edit"
    abbr --add czs "chezmoi status"

    function fish_greeting
        set -l label (set_color --bold)
        set -l value (set_color normal; set_color green)
        echo
        echo " $label""OS: $value"(uname -ro)(set_color normal)
        echo " $label""Hostname: $value$hostname"(set_color normal)
    end

    # Cache generated shell code, regenerating only when the binary is newer
    # (saves ~190ms per shell). Fails if the binary is missing or nothing
    # usable was generated; a failed run never overwrites the cache.
    function __cached_gen -a out bin
        command -q $bin; or return 1
        test $out -nt (command -v $bin); and return
        if $argv[3..] > $out.tmp
            mv $out.tmp $out
        else
            rm -f $out.tmp
            test -s $out
        end
    end

    # Completions go to the autoload dir, so fish loads them on first use
    set -l comp_dir ~/.config/fish/completions
    test -d $comp_dir; or mkdir -p $comp_dir
    __cached_gen $comp_dir/gh.fish gh gh completion --shell fish
    __cached_gen $comp_dir/pixi.fish pixi pixi completion --shell fish
    __cached_gen $comp_dir/jj.fish jj env COMPLETE=fish jj

    # Init hooks are sourced per shell; session IDs are computed at source time.
    set -l init_dir ~/.cache/fish/init
    test -d $init_dir; or mkdir -p $init_dir
    __cached_gen $init_dir/zoxide.fish zoxide zoxide init fish; and source $init_dir/zoxide.fish
    __cached_gen $init_dir/starship.fish starship starship init fish --print-full-init; and source $init_dir/starship.fish
    __cached_gen $init_dir/atuin.fish atuin atuin init fish; and source $init_dir/atuin.fish
    functions --erase __cached_gen
end

# --- patroclus ---------------------------------------------------------------
# Generated palette, same source as the editor and the terminal. fish takes
# colours without the leading '#'.
set -g fish_color_normal         {{ .colors.text | replace "#" "" }}
set -g fish_color_command        {{ .colors.accent | replace "#" "" }}
set -g fish_color_keyword        {{ .colors.red | replace "#" "" }}
set -g fish_color_quote          {{ .colors.blue | replace "#" "" }}
set -g fish_color_redirection    {{ .colors.teal | replace "#" "" }}
set -g fish_color_end            {{ .colors.subtext0 | replace "#" "" }}
set -g fish_color_error          {{ .colors.error | replace "#" "" }}
set -g fish_color_param          {{ .colors.text | replace "#" "" }}
set -g fish_color_option         {{ .colors.subtext1 | replace "#" "" }}
set -g fish_color_comment        {{ .colors.comment | replace "#" "" }}
set -g fish_color_operator       {{ .colors.teal | replace "#" "" }}
set -g fish_color_escape         {{ .colors.peach | replace "#" "" }}
set -g fish_color_autosuggestion {{ .colors.overlay1 | replace "#" "" }}
set -g fish_color_cwd            {{ .colors.accent | replace "#" "" }}
set -g fish_color_valid_path     --underline
set -g fish_color_search_match   --background={{ .colors.selection | replace "#" "" }}
set -g fish_color_selection      --background={{ .colors.selection | replace "#" "" }}

set -g fish_pager_color_progress    {{ .colors.subtext0 | replace "#" "" }}
set -g fish_pager_color_prefix      {{ .colors.accent | replace "#" "" }} --bold
set -g fish_pager_color_completion  {{ .colors.text | replace "#" "" }}
set -g fish_pager_color_description {{ .colors.subtext0 | replace "#" "" }}
set -g fish_pager_color_selected_background --background={{ .colors.selection | replace "#" "" }}
