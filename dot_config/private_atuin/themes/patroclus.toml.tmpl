# patroclus for atuin's search UI. Keys left out fall back to atuin's default
# theme.
[theme]
name = "patroclus"

[colors]
Base = "{{ .colors.text }}"
Title = "{{ .colors.accent }}"
Important = "{{ .colors.bright_white }}"
Annotation = "{{ .colors.subtext0 }}"
Guidance = "{{ .colors.comment }}"
Muted = "{{ .colors.comment }}"
AlertInfo = "{{ .colors.success }}"
AlertWarn = "{{ .colors.warning }}"
AlertError = "{{ .colors.error }}"
