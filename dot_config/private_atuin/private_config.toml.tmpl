# Only deviations from atuin's defaults are listed here (checked against the
# 18.16 settings source); the full annotated default config lives at
# https://docs.atuin.sh/configuration/config/

## self-hosted sync server (CT 311 `shade`); internal horizon, so off the
## mesh a sync fails fast and retries later
sync_address = "https://atuin.luhann.com"
{{- if eq .chassis_type "server" }}
## The sync server is on the home network only; this host keeps its own history.
## sync_address stays set: the daemon fetches its capabilities at every start
## regardless, and unset it defaults to the hosted api.atuin.sh.
auto_sync = false
update_check = false
{{- end }}
dialect = "uk"

## prefix, fulltext, fuzzy, skim, daemon-fuzzy (in-memory index served by the daemon)
search_mode = "daemon-fuzzy"

## Starting filter is the first available entry of search.filters. filter_mode is
## deliberately unset: an explicit value skips the availability check, so
## "workspace" outside a git repo would filter on the current directory tree
## rather than falling through to "host".
workspaces = true

## default is "compact"
style = "auto"
history_format = "{time}\t{host}\t{command}\t{duration}"

## Enter executes; tab returns to the shell for editing (default: false)
enter_accept = true

[stats]
ignored_commands = ["cd", "ls", "z", "vi"]

[daemon]
{{- if ne .chassis_type "server" }}
## Socket-activated by atuin-daemon.socket
enabled = true
systemd_socket = true
{{- else }}
## No packaged units here, so the client starts the daemon itself.
enabled = true
autostart = true
{{- end }}
sync_frequency = 60

[search]
filters = ["workspace", "host", "global", "directory"]
