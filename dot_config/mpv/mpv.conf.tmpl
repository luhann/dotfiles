[default]
# ===== Player =====
border=no
msg-module=yes
keep-open=yes                           # keeps the player open after a video/playlist ends
save-position-on-quit=yes               # resume where you left off on next open
pause=yes                               # disables autoplay
prefetch-playlist=yes                   # prefetches the playlist
autocreate-playlist=filter              # playlist from the file's directory (replaces autoload.lua)
osd-font-size=16

# ===== Screenshots =====
screenshot-template="%F - [%P]v%#01n"
screenshot-format=png
screenshot-png-compression=1
screenshot-directory="~/pictures/screenshots"

# ===== Subs =====
sub-auto=fuzzy
sub-color="{{ .colors.bright_yellow }}"
demuxer-mkv-subtitle-preroll=yes
sub-fix-timing=yes
sub-font-size=16
sub-border-size=1.0
sub-margin-x=100
sub-margin-y=50
sub-visibility=no

# ===== RAM =====
cache=yes                               # uses a large seekable RAM cache even for local input.
cache-secs=300                          # uses extra large RAM cache (needs cache=yes to make it useful).
demuxer-max-back-bytes=300M              # sets fast seeking
demuxer-max-bytes=300M                   # sets fast seeking

# ===== Audio =====
volume=70
volume-max=100
audio-file-auto=fuzzy

# ===== Languages =====
alang=jpn,jp,eng,en
slang=eng,en

# ===== Video =====
profile=high-quality
# gpu-next, the default since mpv 0.41, stutters on the nvidia machine
{{ if .has_nvidia -}}
vo=gpu
{{- else -}}
target-colorspace-hint-mode=source
{{- end }}

# ===== Hardware Accel =====
hwdec=auto-safe
