/*
 * patroclus — rofi.
 *
 * The theme proper is patroclus-base.rasi beside this file: maintained in
 * the patroclus repo and copied here by its tools/gen_tokens.py, alongside
 * the SCSS, LaTeX, Typst and tridactyl consumers. This template only
 * imports it and sets the one property that varies by machine.
 */

@import "patroclus-base"

window {
    /* wider on the smaller laptop screen, 5-10% on desktop */
    width: {{ if eq .chassis_type "laptop" }}30%{{ else }}18%{{ end }};
}
