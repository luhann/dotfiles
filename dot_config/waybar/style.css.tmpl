/* patroclus. GTK's alpha() multiplies a colour's alpha, so the palette stays
   the single source and only the transparency lives here. */

/*base background color*/
@define-color bg_main alpha({{ .colors.base }}, 0.0);
@define-color bg_main_tooltip alpha({{ .colors.mantle }}, 0.92);


/*base background color of selections */
@define-color bg_hover alpha({{ .colors.selection }}, 0.0);
/*base background color of active elements */
@define-color bg_active alpha({{ .colors.accent }}, 0.25);

/*base border color*/
@define-color border_main alpha({{ .colors.border }}, 0.0);

/*text color for entries, views and content in general */
@define-color content_main {{ .colors.accent }};
/*text color for entries that are unselected */
@define-color content_inactive alpha({{ .colors.subtext0 }}, 0.7);

/* Used by the urgent/warning/critical rules below. These were referenced but
   never defined, so GTK could not resolve them and dropped those declarations. */
@define-color warning_color {{ .colors.warning }};
@define-color error_color {{ .colors.error }};

* {
	text-shadow: none;
	box-shadow: none;
	border: none;
	border-radius: 0;
	font-family: "Monaspace Krypton Var";
	font-weight: 600;
	font-size: 12.7px;
}

window#waybar {
	background: @bg_main;
	border-top: 1px solid @border_main;
	color: @content_main;
}

tooltip {
	background: @bg_main_tooltip;
	border-radius: 5px;
	border-width: 0px;
	border-style: solid;
	border-color: @border_main;
}

tooltip label {
	color: {{ .colors.text }};
}

#user {
	font-weight: bold;
	color: @content_inactive;
}

#custom-os_button {
	font-family: "Iosevka Nerd Font";
	font-size: 24px;
	padding-left: 12px;
	padding-right: 20px;
	transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
}

#custom-os_button:hover {
	background: @bg_hover;
	color: @content_main;
}

#custom-dunst {
	padding-right: 10px;
	padding-left: 10px;
}

#custom-dunst.paused {
	color: @content_inactive;
}

#idle_inhibitor.activated {
	color: @content_inactive;
}

#workspaces {
	color: transparent;
	margin-right: 1.5px;
	margin-left: 1.5px;
}

#workspaces button {
	padding: 3px;
	color: @content_inactive;
	transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
}

#workspaces button.empty {
	color: transparent;
}

#workspaces button.active {
	color: @content_main;
	border-bottom: 3px solid @content_main;
}

#workspaces button.focused {
	color: @content_main;
}

#workspaces button.urgent {
	background: alpha(@warning_color, 0.35);
	border-bottom: 3px dashed @warning_color;
	color: @warning_color;
}

#workspaces button:hover {
	background: @bg_hover;
	color: @content_main;
}

#taskbar {}

#taskbar button {
	border-bottom: 3px solid alpha({{ .colors.teal }}, 0.3);
	margin-left: 2px;
	margin-right: 2px;
	padding-left: 8px;
	padding-right: 8px;
	color: {{ .colors.text }};
	transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
}

#taskbar button.active {
	border-bottom: 3px solid @content_main;
	background: @bg_active;
}

#taskbar button:hover {
	border-bottom: 3px solid @content_inactive;
	background: @bg_hover;
	color: @content_main;
}

#cpu,
#disk,
#memory {
	padding: 3px;
}

#temperature {
	color: transparent;
	font-size: 0px;
	transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
}

#temperature.critical {
	padding-right: 3px;
	color: @warning_color;
	font-size: initial;
	border-bottom: 3px dashed @warning_color;
	transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
}

#window {
	border-radius: 10px;
	margin-left: 20px;
	margin-right: 20px;
}

#tray {
	margin-left: 5px;
	margin-right: 5px;
}

#tray>.passive {
	border-bottom: none;
}

#tray>.active {
	border-bottom: 3px solid {{ .colors.text }};
}

#tray>.needs-attention {
	border-bottom: 3px solid @warning_color;
}

#tray>widget {
	transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
}

#tray>widget:hover {
	background: @bg_hover;
}

#battery.charging {
  color: {{ .colors.green }};
  background: transparent;
}

#battery.warning {
  background: transparent;
}

#battery.critical {
  color: @error_color;
  background: transparent;
}

#wireplumber {
	color: @content_inactive;
	font-family: "Monaspace Krypton Var";
	padding-left: 3px;
	padding-right: 3px;
	transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
}

#wireplumber.muted {
	color: @content_inactive;
	font-weight: bold;
}

#wireplumber:hover {
	color: @content_inactive;
	background: @bg_hover;
}

#mpris.playing {
  color: @content_main;
}

#mpris.paused {
  color: @content_inactive;
}

#network {
	padding-left: 3px;
	padding-right: 3px;
}

#language {
	padding-left: 5px;
	padding-right: 5px;
}

#clock {
	padding-right: 5px;
	padding-left: 5px;
	transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
}

#clock:hover {
	background: @bg_hover;
}
