#:schema https://docs.jj-vcs.dev/latest/config-schema.json

[user]
name = {{ .identity.name | quote }}
email = {{ .identity.email | quote }}

[ui]
default-command = ["st"]
pager = "delta"
diff-formatter = ":git"

[signing]
behavior = "drop"
backend = "gpg"
{{- if lookPath "gpg-sq" }}
# Sequoia's gpg chameleon; secrets still go through gpg-agent
backends.gpg.program = "gpg-sq"
{{- end }}

[git]
sign-on-push = true
private-commits = "description('wip:*') | description('private:*')"

[snapshot]
auto-update-stale = true

[working-copy]
eol-conversion = "input"

[templates]
# The change's diff under the description, as git's commit.verbose does
draft_commit_description = '''
concat(
  builtin_draft_commit_description,
  "\nJJ: ignore-rest\n",
  diff.git(),
)
'''

[revsets]
bookmark-advance-to = "closest_pushable(@)"

[revset-aliases]
"closest_pushable(to)" = "heads(::to & mutable() & ~description(exact:\"\") & (~empty() | merges()))"
"why_immutable(r)" = "(r & immutable()) | roots(r:: & immutable_heads())"

[aliases]
chore = ["log", "-r", "description(glob:'chore:*')"]
la = ["log", "-r", "all()"]
lla = ["log", "-r", "all() | hidden()"]
# heads(): falls back to trunk() (an empty diff) once everything is pushed
out = ["diff", "--from", "trunk()", "--to", "heads(trunk() | closest_pushable(@))"]
lout = ["log", "-p", "-r", "trunk()..closest_pushable(@)"]
sr = ["show", "-r", "@"]
tug = ["bookmark", "move", "--from", "heads(::@- & bookmarks())", "--to", "@"]
tug- = ["bookmark", "move", "--from", "heads(::@- & bookmarks())", "--to", "@-"]

# Signature status on `jj show` alone: verifying costs ~8ms per signed commit,
# which adds up over a log. Scopes go last, after every plain table.
[[--scope]]
--when.commands = ["show"]
[--scope.ui]
show-cryptographic-signatures = true
